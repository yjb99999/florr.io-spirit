<Window x:Class="FlorrTeach.Views.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FlorrTeach.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="430" Height="360">
    <Border x:Name="RootBorder" Background="#CC464646" CornerRadius="16" Padding="18,14,18,16">
        <StackPanel>
            <Grid x:Name="TitleBar" Height="22" Background="Transparent" Margin="0,0,0,10">
                <Button x:Name="BtnClose" Content="×" Width="26" Height="22" HorizontalAlignment="Right"
                        Background="Transparent" Foreground="#D9FFFFFF" BorderThickness="0" FontSize="20" FontWeight="Bold" Cursor="Hand"/>
                <TextBlock x:Name="TitleText" Text="倒计时" Foreground="White" FontSize="14" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 设置阶段：苹果风格分 / 秒滚轮 -->
            <Grid x:Name="PickerPanel" Height="200" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <local:WheelPicker x:Name="MinutePicker"/>
                    <TextBlock Text="分" FontSize="18" FontWeight="SemiBold" Margin="8,0,8,0"
                               VerticalAlignment="Center" Foreground="#FFC7C7CC"/>
                    <local:WheelPicker x:Name="SecondPicker"/>
                    <TextBlock Text="秒" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"
                               VerticalAlignment="Center" Foreground="#FFC7C7CC"/>
                </StackPanel>
            </Grid>

            <!-- 运行阶段：剩余时间大字 -->
            <TextBlock x:Name="TimeText" FontFamily="Consolas, Microsoft YaHei" FontSize="40" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" Margin="0,4,0,8" Text="00:05:00"
                       Visibility="Collapsed"/>

            <TextBlock x:Name="StatusText" Foreground="#FFD27A" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnToggle" Content="开始" MinWidth="90" Height="34" Background="#2EFFFFFF"
                        Foreground="White" BorderBrush="#59FFFFFF" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0"/>
                <Button x:Name="BtnPause" Content="暂停" MinWidth="90" Height="34" Background="#2EFFFFFF"
                        Foreground="White" BorderBrush="#59FFFFFF" BorderThickness="1" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
