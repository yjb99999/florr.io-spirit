<Window x:Class="FlorrTeach.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="460" Height="620"
        WindowStartupLocation="CenterScreen"
        Background="#f8fafc"
        ResizeMode="CanResize">
    <Grid Margin="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,20,22,20">

                <!-- 时间设置 -->
                <Border Background="#f8fafc" CornerRadius="10" Padding="16,14,16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="时间设置" FontSize="14" FontWeight="Bold" Foreground="#0b6bcb" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="时钟主题：" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton x:Name="RadioBlack" Content="1. 黑底白字" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioWhite" Content="2. 白底黑字" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 随机点名 -->
                <Border Background="#f8fafc" CornerRadius="10" Padding="16,14,16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="随机点名" FontSize="14" FontWeight="Bold" Foreground="#0b6bcb" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ClassLabel" Text="班级：未设置" Foreground="#444444" FontSize="13" Margin="0,0,0,10"/>
                        <Button x:Name="BtnOpenName" Content="打开名单文件" Background="#15803d" Foreground="White"
                                BorderThickness="0" Padding="10,7" Cursor="Hand" HorizontalAlignment="Left"/>
                        <TextBlock Text="名单文件：name.txt，第一行班级名，后面每行一个名字" Foreground="#888888"
                                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 悬浮球大小 -->
                <Border Background="#f8fafc" CornerRadius="10" Padding="16,14,16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="悬浮球大小" FontSize="14" FontWeight="Bold" Foreground="#0b6bcb" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioSizeSmall" Content="较小（48px）" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioSizeMedium" Content="中等（64px）" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioSizeLarge" Content="较大（80px）" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 每日值日表 -->
                <Border Background="#f8fafc" CornerRadius="10" Padding="16,14,16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="每日值日表" FontSize="14" FontWeight="Bold" Foreground="#0b6bcb" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ChkDuty" Content="启用值日提醒" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Button x:Name="BtnOpenDuty" Content="打开值日文件" Background="#0b6bcb" Foreground="White"
                                    BorderThickness="0" Padding="10,7" Cursor="Hand"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="中午值日时间：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="NoonTime" Width="80" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="晚上值日时间：" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="EveningTime" Width="80" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="DutyStatus" Text="未设置值日表" Foreground="#888888" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="值日文件：clean.txt，格式：星期几 / 名字:值务（扫地2人、拖地1人、擦黑板1人、摆桌子1人、搬课间餐1人）"
                                   Foreground="#888888" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 程序 -->
                <Border Background="#f8fafc" CornerRadius="10" Padding="16,14,16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="程序" FontSize="14" FontWeight="Bold" Foreground="#0b6bcb" Margin="0,0,0,10"/>
                        <Button x:Name="BtnRefresh" Content="刷新程序" Background="#f59e0b" Foreground="White"
                                BorderThickness="0" Padding="16,7" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                        <TextBlock Text="自动结束悬浮进程（每行一个进程名，如：班级优化大师.exe）" Foreground="#666666" FontSize="12" Margin="0,0,0,6"/>
                        <TextBox x:Name="KillEdit" Height="80" AcceptsReturn="True" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                        <TextBlock Text="杀进程频率：" Foreground="#666666" FontSize="12" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RadioFreq5" Content="5秒一次" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioFreq10" Content="10秒一次" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioFreq30" Content="30秒一次" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioFreqBoot" Content="开机时只杀一次" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <RadioButton x:Name="RadioFreqCustom" Content="自定义" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="CustomRow" Orientation="Horizontal" Margin="0,8,0,0" IsEnabled="False">
                            <TextBlock Text="间隔秒数：" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#666666"/>
                            <TextBox x:Name="KillIntervalEdit" Width="90" VerticalAlignment="Center" Text="10"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 开发者模式 -->
                <Border Background="#f8fafc" CornerRadius="10" Padding="16,14,16,14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="开发者模式" FontSize="14" FontWeight="Bold" Foreground="#0b6bcb" Margin="0,0,0,10"/>

                        <StackPanel x:Name="DevLockedPanel">
                            <TextBlock Text="输入两个密码以开启开发者模式。" Foreground="#666666" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <PasswordBox x:Name="DevPwd1" Height="34" VerticalAlignment="Center" Margin="0,0,0,8"
                                         Tag="第一密码" Background="White" BorderBrush="#cccccc"/>
                            <PasswordBox x:Name="DevPwd2" Height="34" VerticalAlignment="Center" Margin="0,0,0,10"
                                         Tag="第二密码" Background="White" BorderBrush="#cccccc"/>
                            <Button x:Name="BtnDevActivate" Content="激活开发者模式" Background="#374151" Foreground="White"
                                    BorderThickness="0" Padding="16,7" Cursor="Hand" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel x:Name="DevUnlockedPanel" Visibility="Collapsed">
                            <TextBlock Text="✓ 开发者模式已开启" Foreground="#15803d" FontWeight="Bold" Margin="0,0,0,10"/>

                            <Button x:Name="BtnPickIcon" Content="自定义悬浮球图标（.png）" Background="#0b6bcb" Foreground="White"
                                    BorderThickness="0" Padding="16,7" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock x:Name="IconPathLabel" Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>

                            <TextBlock Text="界面主题（独立于全局时钟主题）" FontSize="13" Foreground="#444444" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <RadioButton x:Name="RadioThemeFollow" Content="跟随全局" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="RadioThemeBlack" Content="黑底" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="RadioThemeWhite" Content="白底" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="悬浮球大小" FontSize="13" Foreground="#444444" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="BallSizeSlider" Minimum="40" Maximum="100" Value="64" Width="220"
                                        VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="BallSizeLabel" Text="64 px" VerticalAlignment="Center" Foreground="#444444"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button x:Name="BtnOk" Content="完成" Background="#374151" Foreground="White" BorderThickness="0"
                            Padding="26,8" Cursor="Hand" MinWidth="100"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
