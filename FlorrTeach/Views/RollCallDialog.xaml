<Window x:Class="FlorrTeach.Views.RollCallDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="380" Height="260"
        ResizeMode="NoResize">
    <Border x:Name="RootBorder" Background="White" CornerRadius="14" Padding="24,20,24,20" BorderBrush="#e5e7eb" BorderThickness="1">
        <StackPanel>
            <Grid x:Name="TitleBar" Background="Transparent" Margin="0,0,0,14">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="NameBox" CornerRadius="14" Background="#EAF2FB" MinHeight="110" Margin="0,0,0,14">
                <TextBlock x:Name="NameText" Text="准备开始" FontSize="34" FontWeight="Bold"
                           Foreground="#0b4a8a" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="BtnPick" Content="开始抽取" MinWidth="120" Height="38" Margin="0,0,10,0"
                        Background="#0b6bcb" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button x:Name="BtnClose" Content="关闭" MinWidth="120" Height="38"
                        Background="#e5e7eb" Foreground="#333333" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
