<UserControl x:Class="FlorrTeach.Views.WheelPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="80" Height="200" Background="Transparent">
    <Grid x:Name="MaskBorder" ClipToBounds="True" Background="Transparent">
        <Canvas x:Name="ItemsCanvas"/>

        <!-- 中间选中高亮条 -->
        <Border x:Name="SelectionBand" VerticalAlignment="Center" Height="40"
                Background="#14000000" BorderBrush="#22FFFFFF" BorderThickness="0,1"/>

        <!-- 上下淡出遮罩 -->
        <Rectangle x:Name="TopMask" VerticalAlignment="Top" Height="48"/>
        <Rectangle x:Name="BottomMask" VerticalAlignment="Bottom" Height="48"/>
    </Grid>
</UserControl>
